    {
      "name": "User",
      "item": [
        {
          "name": "Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{base_url}}/api/user/dashboard",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "dashboard"]
            }
          }
        },
        {
          "name": "Create Case",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.id) pm.environment.set('caseId', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "photograph", "type": "file", "src": [] },
                { "key": "fullName", "type": "text", "value": "John Doe" },
                { "key": "age", "type": "text", "value": "34" },
                { "key": "gender", "type": "text", "value": "Male" },
                { "key": "height", "type": "text", "value": "175cm" },
                { "key": "physicalDescription", "type": "text", "value": "Tall, dark complexion, small scar on left cheek" },
                { "key": "clothingLastSeen", "type": "text", "value": "Blue shirt and black trousers" },
                { "key": "lastKnownLocation", "type": "text", "value": "Umuahia, Abia State" },
                { "key": "dateLastSeen", "type": "text", "value": "2026-09-20" },
                { "key": "timeLastSeen", "type": "text", "value": "14:30" },
                { "key": "additionalInfo", "type": "text", "value": "Was last seen leaving the market" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/user/cases",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "cases"]
            }
          }
        },
        {
          "name": "List My Cases",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{base_url}}/api/user/cases",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "cases"]
            }
          }
        },
        {
          "name": "Get My Case",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{base_url}}/api/user/cases/{{caseId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "cases", "{{caseId}}"]
            }
          }
        },
        {
          "name": "Update My Case",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "lastKnownLocation", "type": "text", "value": "Umuahia, Abia State (updated)" },
                { "key": "additionalInfo", "type": "text", "value": "New information from a family friend" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/user/cases/{{caseId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "cases", "{{caseId}}"]
            }
          }
        },
        {
          "name": "Delete My Case",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{base_url}}/api/user/cases/{{caseId}}",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "cases", "{{caseId}}"]
            }
          }
        }
      ]
    },

# ---------- APP ----------
APP_NAME=SEARCHWYZ
PORT=5000
NODE_ENV=development

# ---------- DATABASE ----------
MONGO_URI=mongodb://127.0.0.1:27017/searchwyz
ERROR_LOG_URL=mongodb://127.0.0.1:27017/searchwyz_logs
LOG_LEVEL=info

# ---------- CORS ----------
# Comma-separated list of allowed origins
CORS_WHITELISTS=http://localhost:4000,http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---------- TOKENS ----------
ACCESS_TOKEN_SECRET=change_me_access
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_refresh
REFRESH_TOKEN_EXPIRES_IN=7d

# ---------- OTP / RESET ----------
OTP_EXPIRES_MINUTES=1
OTP_RESEND_COOLDOWN_SECONDS=60
RESET_TOKEN_EXPIRES_MINUTES=5

# ---------- CLOUDINARY ----------
CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me

# ---------- EMAIL (Nodemailer) ----------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=change_me@example.com
EMAIL_PASS=change_me_app_password

# ---------- SEED ADMIN ----------
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@searchwyz.com
ADMIN_PASSWORD=change_me_admin_password